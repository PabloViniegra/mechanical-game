{
  "name": "teclado-zombie",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "python3 -m http.server 8000",
    "lint": "oxlint --deny-warnings js tests e2e playwright.config.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && node --check js/main.js && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "oxlint": "^1.90.0"
  }
}
