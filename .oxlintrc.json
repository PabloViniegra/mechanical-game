{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": false,
    "node": false
  },
  "rules": {
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["js/main.js", "js/platform/*.js", "js/render/*.js"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["tests/*.js", "e2e/*.js", "playwright.config.js"],
      "env": {
        "node": true
      }
    }
  ]
}
